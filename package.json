{
  "name": "n8n-nodes-social-media-scheduler",
  "version": "0.1.0",
  "description": "n8n community node for social media scheduling — schedule posts, manage a unified inbox and generate AI content across 20 platforms (Instagram, TikTok, X, LinkedIn, YouTube, Facebook, Threads and more). Powered by So-me Studio.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "social-media-scheduler",
    "social-media",
    "scheduler",
    "post-scheduler",
    "content-calendar",
    "instagram",
    "tiktok",
    "linkedin",
    "twitter",
    "youtube",
    "facebook",
    "threads",
    "social-media-management",
    "automation",
    "so-me"
  ],
  "license": "MIT",
  "homepage": "https://so-me.studio",
  "author": {
    "name": "so-me.studio",
    "email": "walidmahade@gmail.com",
    "url": "https://so-me.studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7t1-studio/n8n-nodes-social-media-scheduler.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SoMeStudioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SoMeStudio/SoMeStudio.node.js",
      "dist/nodes/SoMeStudioTrigger/SoMeStudioTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.45.4",
    "@types/node": "^20.0.0",
    "eslint": "9.29.0",
    "n8n-workflow": "2.16.0",
    "prettier": "^3.6.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "bugs": {
    "url": "https://github.com/7t1-studio/n8n-nodes-social-media-scheduler/issues"
  }
}
